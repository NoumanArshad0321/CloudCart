# CloudCart — example environment file.
# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
# NEVER commit the real .env file to GitHub. Set secrets in the Render
# dashboard for the deployed app.

# A long random string that signs sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# There are no other secrets. Images are stored on the server's own
# disk (instance/uploads/) — no cloud storage account is needed.
